{% comment %}Project card used by the projects page. Expects a variable named project.{% endcomment %}
<a class="proj-card" href="{{ project.url | relative_url }}">
  <div class="proj-card-top">
    <span class="proj-status">{{ project.status }}</span>
  </div>
  <h5 class="proj-title">{{ project.title }}</h5>
  <p class="proj-desc">{{ project.description }}</p>
  <div class="proj-tags">
    {% for t in project.tags limit: 5 %}<span class="proj-tag">{{ t }}</span>{% endfor %}
  </div>
  {% if project.related and project.related.size > 0 %}
  <p class="proj-rel">
    Connects to:
    {% for rid in project.related %}{% assign rp = site.projects | where: "pid", rid | first %}{% if rp %}{{ rp.short_title | default: rp.title }}{% unless forloop.last %}, {% endunless %}{% endif %}{% endfor %}
  </p>
  {% endif %}
</a>
