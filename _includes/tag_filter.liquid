<style>
  .tag-filter-bar {
    margin: 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag-filter-btn {
    border: 1px solid var(--global-divider-color, #ccc);
    background: transparent;
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.85rem;
    cursor: pointer;
    color: inherit;
  }
  .tag-filter-btn.active {
    background: var(--global-theme-color, #007bff);
    color: #fff;
    border-color: var(--global-theme-color, #007bff);
  }
  .tag-filter-item[hidden] {
    display: none !important;
  }
</style>

<div class="tag-filter-bar" id="{{ include.container_id }}-filterbar" data-target="{{ include.container_id }}">
  <button type="button" class="tag-filter-btn active" data-tag="all">all</button>
  {% for tag in include.tags %}
    <button type="button" class="tag-filter-btn" data-tag="{{ tag }}">{{ tag }}</button>
  {% endfor %}
</div>

<script>
  (function () {
    var barId = '{{ include.container_id }}-filterbar';
    var bar = document.getElementById(barId);
    if (!bar) return;
    var targetSelector = '[data-filter-group="' + bar.dataset.target + '"]';

    bar.addEventListener('click', function (e) {
      var btn = e.target.closest('.tag-filter-btn');
      if (!btn) return;

      bar.querySelectorAll('.tag-filter-btn').forEach(function (b) {
        b.classList.remove('active');
      });
      btn.classList.add('active');

      var tag = btn.dataset.tag;
      document.querySelectorAll(targetSelector).forEach(function (item) {
        if (tag === 'all') {
          item.hidden = false;
          return;
        }
        var itemTags = (item.dataset.tags || '').split(',');
        item.hidden = itemTags.indexOf(tag) === -1;
      });
    });
  })();
</script>
