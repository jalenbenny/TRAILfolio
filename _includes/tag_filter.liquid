{% comment %}
  Renders a row of tag-filter pill buttons plus an "all" button, and the
  client-side JS that shows/hides sibling cards based on which pill is
  active. Works together with the search boxes on projects.md and
  repositories.md, which toggle the same "tag-filter-hidden" class.

  Styled with plain CSS here rather than framework button classes, since
  this theme does not actually load Bootstrap.

  Params:
    container_id - string, must match the data-filter-group value used on
                   the item wrapper divs on the page
    tags         - array of tag strings to render as pills
{% endcomment %}
<div class="tag-filter mb-3" id="{{ include.container_id }}-filter" data-filter-group-controls="{{ include.container_id }}">
  <button type="button" class="tag-filter-btn active" data-tag="all">all</button>
  {% for tag in include.tags %}
  <button type="button" class="tag-filter-btn" data-tag="{{ tag }}">{{ tag }}</button>
  {% endfor %}
</div>

<style>
  .tag-filter-hidden { display: none !important; }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-filter-btn {
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(127, 127, 127, 0.35);
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .tag-filter-btn:hover {
    background: rgba(127, 127, 127, 0.14);
  }

  .tag-filter-btn.active {
    background: #4fa3c7;
    border-color: #4fa3c7;
    color: #0b0e12;
    font-weight: 600;
  }
</style>

<script>
(function () {
  var filterId = {{ include.container_id | jsonify }};
  var container = document.getElementById(filterId + "-filter");
  if (!container) return;

  var buttons = container.querySelectorAll(".tag-filter-btn");
  buttons.forEach(function (btn) {
    btn.addEventListener("click", function () {
      buttons.forEach(function (b) { b.classList.remove("active"); });
      btn.classList.add("active");

      var tag = btn.getAttribute("data-tag");
      document.querySelectorAll('[data-filter-group="' + filterId + '"]').forEach(function (item) {
        if (tag === "all") {
          item.classList.remove("tag-filter-hidden");
          return;
        }
        var itemTags = (item.getAttribute("data-tags") || "").split(",");
        item.classList.toggle("tag-filter-hidden", itemTags.indexOf(tag) === -1);
      });
    });
  });
})();
</script>
