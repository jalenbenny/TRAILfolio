{% assign readme_text = site.data.readmes[page.pid] %}
{% if readme_text and readme_text != "" %}
{% capture img_prefix %}src="{{ '/assets/img/readmes/' | relative_url }}{% endcapture %}
<section class="proj-readme">
  <div class="proj-readme-bar"><strong>Project README</strong><span>From the lab's project repository</span></div>
  <div class="repo-readme">
    {{ readme_text | markdownify | replace: 'src="/assets/img/readmes/', img_prefix }}
  </div>
</section>
{% endif %}
