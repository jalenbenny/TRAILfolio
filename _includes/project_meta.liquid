{% assign area_obj = site.data.research_areas | where: "id", page.area | first %}
<style>
  .proj-meta { margin: 0.5rem 0 1.6rem; padding: 1.1rem 1.3rem; border: 1px solid rgba(127,127,127,0.28); border-radius: 14px; background: rgba(127,127,127,0.06); }
  .proj-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.9rem; }
  .proj-chip { display: inline-block; font-size: 0.78rem; line-height: 1; padding: 0.4rem 0.8rem; border-radius: 999px; border: 1px solid rgba(127,127,127,0.4); }
  .proj-chip a { text-decoration: none; }
  .proj-chip-area { border-color: #4fa3c7; background: rgba(79,163,199,0.12); }
  .proj-facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.45rem 1.2rem; margin: 0; font-size: 0.92rem; }
  .proj-facts dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.65; padding-top: 0.2rem; }
  .proj-facts dd { margin: 0; }

  .proj-block { margin: 2rem 0; }
  .proj-block h2, .proj-h2 { font-size: 1.2rem; margin: 0 0 0.7rem; padding-left: 0.7rem; border-left: 3px solid #4fa3c7; line-height: 1.2; }
  .proj-block p { max-width: 62rem; }

  .proj-readme { margin: 2rem 0; border: 1px solid rgba(127,127,127,0.3); border-radius: 14px; overflow: hidden; }
  .proj-readme-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.65rem 1.2rem; background: rgba(127,127,127,0.14); border-bottom: 1px solid rgba(127,127,127,0.3); font-size: 0.8rem; }
  .proj-readme-bar strong { letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.74rem; }
  .proj-readme-bar span { opacity: 0.65; }
  .repo-readme { padding: 1.4rem 1.6rem; background: rgba(127,127,127,0.04); font-size: 0.93rem; line-height: 1.65; overflow-x: auto; }
  .repo-readme > :first-child { margin-top: 0; }
  .repo-readme h1, .repo-readme h2, .repo-readme h3, .repo-readme h4 { font-weight: 600; line-height: 1.3; margin: 1.6rem 0 0.6rem; }
  .repo-readme h1 { font-size: 1.25rem; }
  .repo-readme h2 { font-size: 1.1rem; padding-bottom: 0.3rem; border-bottom: 1px solid rgba(127,127,127,0.3); }
  .repo-readme h3 { font-size: 1rem; }
  .repo-readme h4 { font-size: 0.93rem; }
  .repo-readme img { max-width: 100%; height: auto; border-radius: 8px; border: 1px solid rgba(127,127,127,0.25); margin: 0.4rem 0; }
  .repo-readme code { font-size: 0.85em; padding: 0.12rem 0.4rem; border-radius: 6px; background: rgba(127,127,127,0.18); }
  .repo-readme pre { padding: 0.9rem 1rem; border-radius: 10px; background: rgba(127,127,127,0.14); overflow-x: auto; }
  .repo-readme pre code { padding: 0; background: none; }
  .repo-readme blockquote { margin: 1rem 0; padding: 0.2rem 1rem; border-left: 3px solid rgba(127,127,127,0.45); opacity: 0.9; }
  .repo-readme table { border-collapse: collapse; width: 100%; font-size: 0.88rem; margin: 1rem 0; }
  .repo-readme th { text-align: left; background: rgba(127,127,127,0.14); }
  .repo-readme th, .repo-readme td { border: 1px solid rgba(127,127,127,0.3); padding: 0.45rem 0.7rem; }
  .repo-readme tr:nth-child(even) td { background: rgba(127,127,127,0.06); }
  .repo-readme hr { border: 0; border-top: 1px solid rgba(127,127,127,0.3); margin: 1.6rem 0; }

  .proj-related { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .proj-related a { display: inline-block; padding: 0.5rem 0.9rem; border: 1px solid rgba(127,127,127,0.35); border-radius: 10px; font-size: 0.88rem; text-decoration: none; }
  .proj-related a:hover { border-color: #4fa3c7; background: rgba(79,163,199,0.12); }
  @media (max-width: 600px) { .proj-facts { grid-template-columns: 1fr; } .proj-facts dd { margin-bottom: 0.4rem; } .repo-readme { padding: 1rem; } }
</style>
<div class="proj-meta">
  <div class="proj-chips">
    {% if area_obj %}<span class="proj-chip proj-chip-area"><a href="{{ '/projects/' | relative_url }}#{{ area_obj.id }}">{{ area_obj.title }}</a></span>{% endif %}
    {% if page.status %}<span class="proj-chip">{{ page.status }}</span>{% endif %}
  </div>
  <dl class="proj-facts">
    {% if page.team %}<dt>Team</dt><dd>{{ page.team }}</dd>{% endif %}
    {% if page.repo and site.lab_github_org and site.lab_github_org != "" and site.repos_public %}<dt>Repository</dt><dd><a href="https://github.com/{{ site.lab_github_org }}/{{ page.repo }}">github.com/{{ site.lab_github_org }}/{{ page.repo }}</a></dd>{% endif %}
    {% if page.contact %}<dt>Contact</dt><dd><a href="mailto:{{ page.contact }}">{{ page.contact }}</a></dd>{% endif %}
  </dl>
</div>
